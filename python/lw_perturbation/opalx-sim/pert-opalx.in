/*
    pert-opalx.in
    OPALX reproduction setup for python/lw_perturbation/run_lw_test.py

    Physics parameters matched to the Python Lienard-Wiechert perturbation
    benchmark:
      - 256 Gaussian electron macroparticles
      - total bunch charge: -1 nC, represented in OPALX as BCHARGE=+1 nC
        with electron charge state CHARGE=-1
      - mean initial position: (0, 0, 0) m
      - RMS initial position: sigma_x = sigma_y = 1 mm, sigma_z = 0.1 m
      - mean initial momentum: 0 in all directions
      - RMS thermal momentum: 1 eV/c per axis
      - OPAL momentum spread below is beta*gamma = p/(m_e c)
      - constant external field: Ez = -1 MV/m
      - time grid: 150 steps of 0.1 ns = 15 ns, matching 151 Python outputs

    Binning and field-solver choices are intentionally left as placeholders.
*/

OPTION, PSDUMPFREQ      = 10000;
OPTION, STATDUMPFREQ    = 1;
OPTION, BOUNDPDESTROY   = 10;
OPTION, AUTOPHASE       = 4;
OPTION, VERSION         = 10900;
OPTION, STEPINFOFQ      = 20;

Title, string="LW perturbation benchmark: Gaussian bunch in constant Ez";

Value,{OPALVERSION};

// ----------------------------------------------------------------------------
// Python-matched global parameters

REAL n_particles         = 1E7;
REAL beam_bunch_charge   = 1e-12; // 1e-9;          // magnitude in C; electron CHARGE=-1 below
REAL rf_freq             = 1.3e9;         // unused by CONSTANTEFIELDCAVITY, kept for compatibility

REAL sigma_x             = 1.0e-3;        // m
REAL sigma_y             = 1.0e-3;        // m
REAL sigma_z             = 1.0e-3;        // m

REAL p_rms_MeVc          = 1.0e-6;        // 1 eV/c = 1e-6 MeV/c
REAL p_rms_betagamma     = p_rms_MeVc / 0.511;

REAL t_end               = 3e-9; // 15.0e-9;       // s
REAL n_steps             = 800;
REAL dt                  = t_end / n_steps;

// ----------------------------------------------------------------------------
// Initial reference momentum: Python uses zero mean momentum.

REAL Edes    = 1e-9;           // GeV kinetic energy; zero for this benchmark
REAL gamma   = (Edes+EMASS)/EMASS; 
REAL beta    = sqrt(1-(1/gamma^2));
REAL P0      = gamma*beta*EMASS;

Value,{Edes, P0, p_rms_betagamma, dt};

// ----------------------------------------------------------------------------
// Lattice: Python applies a global constant field for the full trajectory.
// A long cavity starting at the source approximates that condition in OPALX.
// Electrons accelerate toward +z because CHARGE=-1 and EZ=-1 MV/m.

E1: CONSTANTEFIELDCAVITY,
    L        = 6.0,
    ELEMEDGE = -1.0,
    EZ       = -1.0;

myLine: Line = (E1);

// ----------------------------------------------------------------------------
// Exact reproduction should use a FROMFILE distribution generated from
// python/lw_perturbation/output/initial_conditions.csv.
//
// The Python CSV columns are:
// id,x_m,y_m,z_m,px_beta_gamma,py_beta_gamma,pz_beta_gamma,
// px_MeVc,py_MeVc,pz_MeVc,macro_charge_C
//
// Convert those columns to the OPALX FROMFILE format you use locally.

//Dist1_FF: DISTRIBUTION, TYPE=FROMFILE,
//    FNAME     = "input-distribution-gauss.txt",
//    NPARTDIST = n_particles;

// Gaussian fallback with the same RMS parameters, useful if a FROMFILE
// conversion is not being used. Keep Dist1_FF active for exact reproducibility.
//
Dist1_GAUSS: DISTRIBUTION, TYPE=GAUSS,
    SIGMAX    = sigma_x,
    SIGMAY    = sigma_y,
    SIGMAZ    = sigma_z,
    SIGMAPX   = p_rms_betagamma,
    SIGMAPY   = p_rms_betagamma,
    SIGMAPZ   = p_rms_betagamma, // 0.1, // p_rms_betagamma * 1E5,
    NPARTDIST = n_particles;

ES1: EMISSIONSOURCE, DISTRIBUTION = Dist1_GAUSS;
mySources: EMISSIONSOURCELIST = (ES1);

BEAM1: BEAM,
    PARTICLE = ELECTRON,
    NALLOC   = n_particles,
    BCHARGE  = beam_bunch_charge,
    SOURCES  = mySources,
    CHARGE   = -1,
    pc       = P0;

// ----------------------------------------------------------------------------
// Placeholder binning and solver block.
// These are intentionally not tuned here; adapt them for your OPALX run.

BINS1: BINNING,
    MAXBINS        = 128,
    DESIREDWIDTH   = 0.05,
    TABLEPRINTFREQ = 100,
    PARAMETER      = GAMMAZ;

FS1: Fieldsolver, TYPE=OPEN, BINS=BINS1,
    NX        = 128,
    NY        = 128,
    NZ        = 128,
    PARFFTX   = true,
    PARFFTY   = true,
    PARFFTZ   = false,
    BCFFTX    = OPEN,
    BCFFTY    = OPEN,
    BCFFTZ    = OPEN, BBOXINCR = 5, GREENSF = STANDARD;

TRACK, LINE = myLine, BEAM = BEAM1, MAXSTEPS = n_steps, DT = dt, ZSTOP = 4.5;
RUN, METHOD = "PARALLEL", FIELDSOLVER = FS1;
ENDTRACK;
QUIT;
